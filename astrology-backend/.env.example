[TEMPLATE]
# Environment variables example

# Primary LLM — Cloudflare Workers AI (Tier 1, OpenAI-compatible edge endpoint)
# Account ID: Cloudflare dashboard right sidebar. API token: Manage API Tokens
# with "Workers AI Read" (run) permission. Cascade falls back to Gemini if unset.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# AstrologyAPI credentials
ASTROLOGYAPI_USER_ID=your_astrology_api_user_id
ASTROLOGYAPI_API_KEY=your_astrology_api_key

# Fallback LLM Tier 2 — Gemini (gemini-2.5-flash)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CHAT_API_KEY=your_gemini_chat_api_key

# Fallback LLM Tiers 3-7 — Groq & OpenRouter
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/astrology_db
REDIS_URL=redis://localhost:6379

# App
# Production CORS_ORIGINS must list ONLY your real frontend origins,
# e.g. https://your-frontend.example.com (comma-separated, no trailing slash).
# A wildcard "*" is accepted ONLY when APP_ENV=development.
CORS_ORIGINS=http://localhost:5173
APP_ENV=development
GEMINI_TRANSLATION_KEY=your_gemini_translation_key_here

# Google Authentication
GOOGLE_CLIENT_ID=your_google_client_id_here

# Session signing secret — MUST be 32+ random characters (enforced in production).
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=generate_me_with_python_secrets_token_hex_32_min

# SECURITY NOTES
# - The real .env is git-ignored. NEVER commit it or copy real keys anywhere.
# - APP_ENV=production enforces a strong JWT_SECRET at startup (server refuses
#   to boot with a weak/missing one) and blocks wildcard CORS.
